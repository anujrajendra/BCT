<?xml version="1.0" encoding="UTF-8"?>

<module xmlns="urn:ebx-schemas:module_2.4"
	xmlns:xml="http://www.w3.org/XML/1998/namespace"
	xmlns:xsi="http://www.w3.org/2000">
	<name>reference_master</name>
	<publicPath>reference_master</publicPath>
	<beans>


		<bean className="com.cris.reference_master.PushToTibcoEMSScript">

			<documentation xml:lang="en-US">

				<label>Publish to Tibco EMS</label>

			</documentation>

			<documentation xml:lang="fr-FR">

				<label>Publier vers Tibco EMS</label>

			</documentation>

			<properties>

				<property name="dataSpaceId" input="true">

					<documentation xml:lang="fr-FR">

						<label>Espace de données</label>

					</documentation>

					<documentation xml:lang="en-US">

						<label>Dataspace</label>

					</documentation>

				</property>

				<property name="dataSetId" input="true">

					<documentation xml:lang="fr-FR">

						<label>Jeu de données</label>

					</documentation>

					<documentation xml:lang="en-US">

						<label>Dataset</label>

					</documentation>

				</property>

				<property name="recordXPath" input="true">

					<documentation xml:lang="fr-FR">

						<label>XPath du record</label>

					</documentation>

					<documentation xml:lang="en-US">

						<label>Record XPath</label>

					</documentation>

				</property>

				<property name="serverUrl" input="true">

					<documentation xml:lang="fr-FR">

						<label>URL du Serveur</label>

					</documentation>

					<documentation xml:lang="en-US">

						<label>Server URL</label>

					</documentation>

				</property>

				<property name="userName" input="true">

					<documentation xml:lang="fr-FR">

						<label>Utilisateur</label>

					</documentation>

					<documentation xml:lang="en-US">

						<label>User name</label>

					</documentation>

				</property>

				<property name="password" input="true">

					<documentation xml:lang="fr-FR">

						<label>Password</label>

					</documentation>

					<documentation xml:lang="en-US">

						<label>Password</label>

					</documentation>

				</property>

				<property name="name" input="true">

					<documentation xml:lang="fr-FR">

						<label>Nom Topic/Queue</label>

					</documentation>

					<documentation xml:lang="en-US">

						<label>Topic/Queue Name</label>

					</documentation>

				</property>

				<property name="useTopic" input="true">

					<documentation xml:lang="fr-FR">

						<label>Topic?</label>

					</documentation>

					<documentation xml:lang="en-US">

						<label>Topic?</label>

					</documentation>

				</property>

				<property name="useAsync" input="true">

					<documentation xml:lang="fr-FR">

						<label>Asynchrone?</label>

					</documentation>

					<documentation xml:lang="en-US">

						<label>Asynch?</label>

					</documentation>

				</property>

			</properties>

		</bean>


		<bean
			className="com.cris.reference_master.workflow.condition.CheckUserRoleConditionTask">
			<documentation xml:lang="en-US">
				<label>Check User Role</label>
			</documentation>
			<properties>
				<property name="dataspaceName" input="true">
					<documentation xml:lang="en-US">
						<label>Dataspace Name</label>
					</documentation>
				</property>
				<property name="datasetName" input="true">
					<documentation xml:lang="en-US">
						<label>Dataset Name</label>
					</documentation>
				</property>
				<property name="tableName" input="true">
					<documentation xml:lang="en-US">
						<label>Table Name</label>
					</documentation>
				</property>
				<property name="record" input="true">
					<documentation xml:lang="en-US">
						<label>Record</label>
					</documentation>
				</property>
				<property name="roleName" input="true">
					<documentation xml:lang="en-US">
						<label>Role Name</label>
					</documentation>
				</property>
			</properties>
		</bean>


		<bean
			className="com.cris.reference_master.workflow.scripttask.RunReconciliationProcedureScriptTask">
			<documentation xml:lang="en-US">
				<label>Call Reconciliation Procedure (Generic; Reference) Script
					Task
				</label>
			</documentation>
			<properties>
				<property name="sqlProcedureName" input="true">
					<documentation xml:lang="en-US">
						<label>SQL Procedure Name</label>
					</documentation>
				</property>
			</properties>
		</bean>
		<bean
			className="com.cris.reference_master.workflow.scripttask.ReconciliationImportFile">
			<documentation xml:lang="en-US">
				<label>Inbound File Import/Transfer Task</label>
			</documentation>
			<properties>
				<property name="dataspace" input="true">
					<documentation xml:lang="en-US">
						<label>Configuration Dataspace Name</label>
						<description>Name of the dataspace, where the inbound file import
							configuration is stored.
						</description>
					</documentation>
				</property>
				<property name="dataset" input="true">
					<documentation xml:lang="en-US">
						<label>Configuration Dataset Name</label>
						<description>Name of the dataset, where the inbound file import
							configuration is stored.
						</description>
					</documentation>
				</property>
				<property name="ImportTableName" input="true">
					<documentation xml:lang="en-US">
						<label>Configuration table</label>
						<description>Name of the table, On which the inbound file import
							is happened.
						</description>
					</documentation>
				</property>
				<property name="ImportMappingName" input="true">
					<documentation xml:lang="en-US">
						<label>Mapping Name </label>
						<description>Name of the mapping based on which import need to be
							taken place.
						</description>
					</documentation>
				</property>
				<property name="ImportFilePath" input="true">
					<documentation xml:lang="en-US">
						<label>File Path</label>
						<description>Location where the inbound file is stored
						</description>
					</documentation>
				</property>
				<property name="TransfertemplateId" input="true">
					<documentation xml:lang="en-US">
						<label>Transfer Template Id</label>
						<description>Id has been stored for transfer template
						</description>
					</documentation>
				</property>
				<property name="Transfer_Master_templateId" input="true">
					<documentation xml:lang="en-US">
						<label>Transfer Template Id for Master data</label>
						<description>Id has been stored for transfer template
						</description>
					</documentation>
				</property>
				<property name="Backup_File_Path" input="true">
					<documentation xml:lang="en-US">
						<label>Backup Path</label>
						<description>Path were backup file will be stored
						</description>
					</documentation>
				</property>
			</properties>
		</bean>

		<bean
			className="com.cris.reference_master.workflow.scripttask.ReconciliationExportFile">
			<documentation xml:lang="en-US">
				<label> File Export Task</label>
			</documentation>
			<properties>


				<property name="ExportFilePath" input="true">
					<documentation xml:lang="en-US">
						<label>ExportFilePath</label>
						<description>Path for Export file. </description>
					</documentation>
				</property>
				<property name="ExporttemplateId" input="true">
					<documentation xml:lang="en-US">
						<label>ExporttemplateId</label>
						<description>Template ID for export. </description>
					</documentation>
				</property>

			</properties>
		</bean>
		<bean
			className="com.cris.reference_master.workflow.scripttask.CustomSendEmail">
			<documentation xml:lang="en-US">
				<label>Custom Send Email</label>
				<description>Custom Script task to send the email</description>
			</documentation>
			<properties>
				<property name="emailTemplateId" input="true">
					<documentation xml:lang="en-US">
						<label>Email Template ID</label>
						<description>Email Template to be used for sending the mail.
						</description>
					</documentation>
				</property>
			</properties>
		</bean>
	</beans>
</module>